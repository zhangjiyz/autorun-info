---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { games, categories } from '../lib/catalog';
---
<Layout>
  <section class="library-heading">
    <div><p class="eyebrow">THE GAME COLLECTION</p><h1>游戏适配库<span class="accent">.</span></h1><p class="lead">查找适配信息，发现玩家分享。</p></div>
    <div class="collection-count"><strong>{String(games.length).padStart(2, '0')}</strong><span>款游戏已收录</span></div>
  </section>
  <section aria-label="筛选游戏" class="library-toolbar">
    <label class="search-box"><Icon name="search"/><span class="sr-only">搜索游戏名称或关键词</span><input id="game-search" type="search" placeholder="搜索游戏名称或关键词…" autocomplete="off"/><kbd>/</kbd></label>
    <label class="sort-box"><span class="sr-only">排序方式</span><select id="game-sort"><option value="default">目录顺序</option><option value="name">按游戏名称</option></select></label>
  </section>
  <div class="filter-row"><div class="filters" role="group" aria-label="游戏分类"><button type="button" class="filter active" aria-pressed="true" data-category="all">全部游戏 <span>{games.length}</span></button>{categories.map(category => <button type="button" class="filter" aria-pressed="false" data-category={category}>{category}</button>)}</div><span id="result-count" class="result-count" role="status">共 {games.length} 款</span></div>
  <section class="game-grid" id="game-grid" aria-label="游戏列表">
    {games.map((game, index) => <article class="game-card" data-name={game.name} data-search={`${game.name} ${game.keywords} ${game.description}`} data-category={game.category} data-order={index}>
      <a class="game-card-link" href={`/games/${game.id}/`}>
        <div class="cover-frame">{game.cover ? <img src={game.cover} alt={`${game.name}封面`} loading={index < 6 ? 'eager' : 'lazy'} decoding="async" width="600" height="900"/> : <div class="cover-placeholder"><Icon name="game" size={48}/><span>ZERO ESCAPE</span><strong>{game.name}</strong><small>暂无封面</small></div>}<span class="cover-label">适配资料 v{game.version}</span></div>
        <div class="game-meta"><span class="game-category">{game.category}</span><h2>{game.name}</h2></div>
      </a>
    </article>)}
  </section>
  <div id="empty-results" class="empty-state" hidden><Icon name="search" size={32}/><h2>没有找到匹配的游戏</h2><p>换个关键词，或清除分类筛选再试试。</p><button type="button" class="button secondary" id="clear-search">清除筛选</button></div>
  <noscript><p class="notice">已显示全部游戏。启用 JavaScript 后可以使用搜索与筛选。</p></noscript>
</Layout>
<script>
  const input = document.querySelector<HTMLInputElement>('#game-search')!;
  const sort = document.querySelector<HTMLSelectElement>('#game-sort')!;
  const grid = document.querySelector<HTMLElement>('#game-grid')!;
  const cards = [...document.querySelectorAll<HTMLElement>('.game-card')];
  const filters = [...document.querySelectorAll<HTMLButtonElement>('.filter')];
  let category = 'all';
  const normalize = (value: string) => value.normalize('NFKC').toLocaleLowerCase().replace(/\s+/g, ' ').trim();
  function update() {
    const terms = normalize(input.value).split(' ').filter(Boolean);
    let count = 0;
    for (const card of cards) {
      const visible = (category === 'all' || card.dataset.category === category) && terms.every(term => normalize(card.dataset.search || '').includes(term));
      card.hidden = !visible;
      if (visible) count++;
    }
    const ordered = [...cards].sort((a, b) => sort.value === 'name' ? (a.dataset.name || '').localeCompare(b.dataset.name || '', 'zh-CN') : Number(a.dataset.order) - Number(b.dataset.order));
    ordered.forEach(card => grid.append(card));
    document.querySelector('#result-count')!.textContent = `共 ${count} 款`;
    document.querySelector<HTMLElement>('#empty-results')!.hidden = count > 0;
    for (const button of filters) { const selected = button.dataset.category === category; button.classList.toggle('active', selected); button.setAttribute('aria-pressed', String(selected)); }
    const url = new URL(location.href);
    input.value.trim() ? url.searchParams.set('q', input.value.trim()) : url.searchParams.delete('q');
    category !== 'all' ? url.searchParams.set('category', category) : url.searchParams.delete('category');
    history.replaceState(null, '', url);
  }
  const params = new URLSearchParams(location.search);
  input.value = params.get('q') || '';
  const initialCategory = params.get('category');
  if (filters.some(button => button.dataset.category === initialCategory)) category = initialCategory!;
  input.addEventListener('input', update); sort.addEventListener('change', update);
  filters.forEach(button => button.addEventListener('click', () => { category = button.dataset.category || 'all'; update(); }));
  document.querySelector('#clear-search')!.addEventListener('click', () => { input.value = ''; category = 'all'; update(); input.focus(); });
  document.addEventListener('keydown', event => { if (event.key === '/' && !(event.target instanceof HTMLInputElement) && !(event.target instanceof HTMLTextAreaElement) && !event.ctrlKey && !event.metaKey) { event.preventDefault(); input.focus(); } });
  update();
</script>
