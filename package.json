{
  "name": "autorun-info",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-local.mjs && npm run db:migrate:local && npm run build && wrangler dev --local --ip 127.0.0.1 --port 8787",
    "dev:ui": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "check": "astro check && tsc -p tsconfig.worker.json",
    "test": "node --test tests/*.test.*",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "db:migrate:local": "wrangler d1 migrations apply autorun-info --local",
    "db:migrate:remote": "wrangler d1 migrations apply autorun-info --remote",
    "deploy": "node scripts/check-deploy.mjs && npm run build && wrangler deploy",
    "preview": "wrangler dev --local --ip 127.0.0.1 --port 8787"
  },
  "dependencies": {
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "26.6.4",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "wrangler": "4.147.0"
  }
}
